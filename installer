# ===========================================================================
# Section 16: Feeding configuration
# ===========================================================================

build_run_command() {
  local decoder="$1"
  local host="${FEED_HOST:-$AIRFRAMES_FEED_HOST}"
  local port="${FEED_PORT:-${DECODER_FEED_PORT[$decoder]}}"
  local freqs="${FREQUENCIES:-$(get_frequencies "$decoder" "${SELECTED_REGION:-north_america}")}"
  local sdr="${SELECTED_SDR:-rtlsdr}"
  [ -n "$SDR_INDEX$SDR_SERIAL" ] || resolve_sdr_device
  local dev soapy_rtl
  dev=$(rtl_device_arg)
  soapy_rtl=$(soapy_rtl_arg)

  # The station ident, as an option for each decoder. Airframes files incoming
  # data under the ident the decoder sends: without it the feed lands on an
  # anonymous station named after this machine's hostname or IP address, and
  # the station registered on the website stays "pending". Idents are free
  # text, so anything beyond plain characters is single-quoted.
  # A caller that writes the command somewhere other than a shell passes the
  # ident as the second argument, already written for that place.
  local ident="${STATION_IDENT:-}"
  local id_short="" id_long=""
  if [ -n "$ident" ]; then
    if [ -n "${2:-}" ]; then
      ident="$2"
    elif [[ ! "$ident" =~ ^[A-Za-z0-9._-]+$ ]]; then
      ident="'${ident//\'/\'\\\'\'}'"
    fi
    id_short=" -i ${ident}"
    id_long=" --station-id ${ident}"
  fi

  case "$decoder" in
    acarsdec)
      echo "acarsdec -v -o 4 -g 42${id_short} -j ${host}:${port} -r ${dev} ${freqs}"
      ;;
    dumpvdl2)
      # dumpvdl2 takes frequencies in Hz
      local freqs_hz=""
      for f in $freqs; do
        if [[ "$f" == *.* ]]; then
          freqs_hz+=" $(echo "$f" | awk '{printf "%.0f", $1 * 1000000}')"
        else
          freqs_hz+=" $f"
        fi
      done
      case "$sdr" in
        rtlsdr)  echo "dumpvdl2 --rtlsdr ${dev}${id_long} --output decoded:json:udp:address=${host},port=${port}${freqs_hz}" ;;
        airspy)  echo "dumpvdl2 --airspy 0${id_long} --output decoded:json:udp:address=${host},port=${port}${freqs_hz}" ;;
        sdrplay) echo "dumpvdl2 --soapysdr driver=sdrplay${id_long} --output decoded:json:udp:address=${host},port=${port}${freqs_hz}" ;;
      esac
      ;;
    dumphfdl)
      local freq_args=""
      for f in $freqs; do
        freq_args+=" ${f}"
      done
      case "$sdr" in
        rtlsdr)  echo "dumphfdl --soapysdr ${soapy_rtl} --sample-rate 250000${id_long} --output decoded:json:tcp:address=${host},port=${port}${freq_args}" ;;
        airspy)  echo "dumphfdl --soapysdr driver=airspy --sample-rate 250000${id_long} --output decoded:json:tcp:address=${host},port=${port}${freq_args}" ;;
        sdrplay) echo "dumphfdl --soapysdr driver=sdrplay --sample-rate 250000${id_long} --output decoded:json:tcp:address=${host},port=${port}${freq_args}" ;;
      esac
      ;;
    vdlm2dec)
      echo "vdlm2dec -v -G -E -U${id_short} -j ${host}:${port} -r ${dev} ${freqs}"
      ;;
  esac
}

