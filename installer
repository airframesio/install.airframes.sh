# Section 16: Feeding configuration
# ===========================================================================

build_run_command() {
  local decoder="$1"
  local host="${FEED_HOST:-$AIRFRAMES_FEED_HOST}"
  local port="${FEED_PORT:-${DECODER_FEED_PORT[$decoder]}}"
  local freqs="${FREQUENCIES:-$(get_frequencies "$decoder" "${SELECTED_REGION:-north_america}")}"
  local sdr="${SELECTED_SDR:-rtlsdr}"
  [ -n "$SDR_INDEX$SDR_SERIAL" ] || resolve_sdr_device
  local dev soapy_rtl
  dev=$(rtl_device_arg)
  soapy_rtl=$(soapy_rtl_arg)

  # The station ident, as an option for each decoder. Airframes files incoming
  # data under the ident the decoder sends: without it the feed lands on an
  # anonymous station named after this machine's hostname or IP address, and
  # the station registered on the website stays "pending". Idents are free
  # text, so anything beyond plain characters is single-quoted.
  # A caller that writes the command somewhere other than a shell passes the
  # ident as the second argument, already written for that place.
  local ident="${STATION_IDENT:-}"
  local id_short="" id_long=""
  if [ -n "$ident" ]; then
    if [ -n "${2:-}" ]; then
      ident="$2"
    elif [[ ! "$ident" =~ ^[A-Za-z0-9._-]+$ ]]; then
      ident="'${ident//\'/\'\\\'\'}'"
    fi
    id_short=" -i ${ident}"
    id_long=" --station-id ${ident}"
  fi

  case "$decoder" in
    acarsdec)
      echo "acarsdec -v -o 4 -g 42${id_short} -j ${host}:${port} -r ${dev} ${freqs}"
      ;;
    dumpvdl2)
      # dumpvdl2 takes frequencies in Hz
      local freqs_hz=""
      for f in $freqs; do
        if [[ "$f" == *.* ]]; then
          freqs_hz+=" $(echo "$f" | awk '{printf "%.0f", $1 * 1000000}')"
        else
          freqs_hz+=" $f"
        fi
      done
      case "$sdr" in
        rtlsdr)  echo "dumpvdl2 --rtlsdr ${dev}${id_long} --output decoded:json:udp:address=${host},port=${port}${freqs_hz}" ;;
        airspy)  echo "dumpvdl2 --airspy 0${id_long} --output decoded:json:udp:address=${host},port=${port}${freqs_hz}" ;;
        sdrplay) echo "dumpvdl2 --soapysdr driver=sdrplay${id_long} --output decoded:json:udp:address=${host},port=${port}${freqs_hz}" ;;
      esac
      ;;
    dumphfdl)
      local freq_args=""
      for f in $freqs; do
        freq_args+=" ${f}"
      done
      case "$sdr" in
        rtlsdr)  echo "dumphfdl --soapysdr ${soapy_rtl} --sample-rate 250000${id_long} --output decoded:json:tcp:address=${host},port=${port}${freq_args}" ;;
        airspy)  echo "dumphfdl --soapysdr driver=airspy --sample-rate 250000${id_long} --output decoded:json:tcp:address=${host},port=${port}${freq_args}" ;;
        sdrplay) echo "dumphfdl --soapysdr driver=sdrplay --sample-rate 250000${id_long} --output decoded:json:tcp:address=${host},port=${port}${freq_args}" ;;
      esac
      ;;
    vdlm2dec)
      echo "vdlm2dec -v -G -E -U${id_short} -j ${host}:${port} -r ${dev} ${freqs}"
      ;;
  esac
}

show_run_command() {
  local decoder="$1"
  local cmd
  cmd=$(build_run_command "$decoder")

  echo
  ok "${decoder} is ready to feed Airframes!"
  echo
  info "Run this command to start feeding:"
  echo -e "  ${DIM}${cmd}${RESET}"
  echo
}

# ===========================================================================
# Section 17: Systemd service creation
# ===========================================================================

create_systemd_service() {
  local decoder="$1"
  local cmd
  # systemd reads ExecStart with its own rules, not a shell's: inside double
  # quotes it still decodes backslash escapes, and it expands % and $ anywhere.
  local unit_ident=""
  if [ -n "${STATION_IDENT:-}" ] && [[ ! "$STATION_IDENT" =~ ^[A-Za-z0-9._-]+$ ]]; then
    unit_ident="${STATION_IDENT//\\/\\\\}"
    unit_ident="${unit_ident//\"/\\\"}"
    unit_ident="${unit_ident//%/%%}"
    unit_ident="${unit_ident//\$/\$\$}"
    unit_ident="\"${unit_ident}\""
  fi
  cmd=$(build_run_command "$decoder" "$unit_ident")

  if [ "$OS" != "linux" ]; then
    warn "Systemd services are only supported on Linux"
    return 1
  fi

  if ! command -v systemctl >/dev/null 2>&1; then
    warn "systemctl not found — cannot create service"
    return 1
  fi

  local service_name="airframes-${decoder}"
  local service_file="/etc/systemd/system/${service_name}.service"

  step "Creating systemd service: ${service_name}"

  sudo tee "$service_file" >/dev/null << EOF
[Unit]
Description=Airframes ${decoder} decoder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${cmd}
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

  sudo systemctl daemon-reload
  sudo systemctl enable "$service_name"
  sudo systemctl start "$service_name"

  ok "Service ${service_name} created and started"
  info "Check status: systemctl status ${service_name}"
  info "View logs: journalctl -u ${service_name} -f"
}

create_launchd_service() {
  local decoder="$1"
  local cmd
  # Build the command around a placeholder so it can be split on spaces, then
  # put the real ident back as one argument. Nothing is evaluated as shell.
  local ident_slot="__AIRFRAMES_STATION_IDENT__"
  cmd=$(build_run_command "$decoder" "$ident_slot")

  if [ "$OS" != "macos" ]; then
    warn "launchd services are only supported on macOS"
    return 1
  fi

  local service_label="io.airframes.${decoder}"
  local plist_dir="$HOME/Library/LaunchAgents"
  local plist_file="${plist_dir}/${service_label}.plist"
  local logfile="/tmp/airframes-${decoder}.log"

  mkdir -p "$plist_dir"

  step "Creating launchd service: ${service_label}"

  # Split command into binary + args array for plist
  local bin
  bin=$(echo "$cmd" | awk '{print $1}')
  local bin_path
  bin_path=$(command -v "$bin" 2>/dev/null || echo "/usr/local/bin/${bin}")

  local -a cmd_args
  read -ra cmd_args <<< "$cmd"

  local args_xml=""
  local first=true
  local arg
  for arg in "${cmd_args[@]}"; do
    if [ "$first" = true ]; then
      args_xml="${args_xml}    <string>${bin_path}</string>
"
      first=false
    else
      if [ "$arg" = "$ident_slot" ]; then
        arg="$STATION_IDENT"
      fi
      # The plist is XML
      arg="${arg//&/\&amp;}"
      arg="${arg//</\&lt;}"
      arg="${arg//>/\&gt;}"
      args_xml="${args_xml}    <string>${arg}</string>
"
    fi
  done

  cat > "$plist_file" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${service_label}</string>
  <key>ProgramArguments</key>
  <array>
${args_xml}  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${logfile}</string>
  <key>StandardErrorPath</key>
  <string>${logfile}</string>
</dict>
</plist>
EOF

  launchctl load "$plist_file"

  ok "Service ${service_label} created and started"
  info "Check logs: tail -f ${logfile}"
  info "Stop: launchctl unload ${plist_file}"
}

install_manager_script() {
  step "Installing airframes manager"

  local install_dir="/usr/local/bin"
  local script_url="https://raw.githubusercontent.com/airframesio/install.airframes.sh/main/airframes-manager"
  local manager_path="${install_dir}/airframes"

  # Try to download from repo; fall back to bundled copy from build dir
  local tmp_script="/tmp/airframes-manager-download"
  if curl -fsSL "$script_url" -o "$tmp_script" 2>/dev/null; then
    sudo install -m 0755 "$tmp_script" "$manager_path"
    rm -f "$tmp_script"
  elif [ -f "${BUILD_DIR}/airframes-manager" ]; then
    sudo install -m 0755 "${BUILD_DIR}/airframes-manager" "$manager_path"
  else
    warn "Could not download airframes manager script"
    info "You can install it manually from: ${script_url}"
    return 0
  fi

  ok "Airframes manager installed to ${manager_path}"
  info "Run 'airframes' for interactive dashboard"
  info "Run 'airframes --help' for all commands"
}

