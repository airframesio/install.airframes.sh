  cmd=$(build_run_command "$decoder")

  sudo tee "$config_file" >/dev/null << EOF
{
  "decoder": "${decoder}",
  "stationIdent": "${ident}",
  "feedHost": "${host}",
  "feedPort": ${port},
  "frequencies": "${freqs}",
  "region": "${region}",
  "sdrType": "${sdr}",
