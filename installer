XNG_MENU_LABEL="Airframes station with xng (recommended): every SDR, every mode"
ADSB_ONLY_MENU_LABEL="ADS-B only, for Airframes' partners Airplanes.Live and Plane Watch"
CLASSIC_MENU_LABEL="Separate decoders (acarsdec, dumpvdl2, dumphfdl, vdlm2dec)"

# First question: the xng station, ADS-B for partners, or separate decoders.
tui_select_setup() {
  step "What would you like to set up?"
  echo -e "  ${DIM}xng decodes ACARS, VDL2, HFDL, AIS, airband voice and ADS-B, picks a job for${RESET}"
  echo -e "  ${DIM}each SDR, and feeds Airframes. Sign in and your station is on your account.${RESET}"
  local choice
  choice=$(ui_choose "Set up:" "$XNG_MENU_LABEL" "$ADSB_ONLY_MENU_LABEL" "$CLASSIC_MENU_LABEL") || exit 0
  case "$choice" in
    "$XNG_MENU_LABEL")       WANT_XNG=true; ok "Setting up an xng station" ;;
    "$ADSB_ONLY_MENU_LABEL") WANT_ADSB=true; ok "Setting up ADS-B for Airframes' partners" ;;
    *)                       tui_select_decoders ;;
  esac
}

tui_select_decoders() {
  if [ "$HAS_GUM" = true ]; then
    step "Select what to install"

    local -a labels=()
    for d in "${DECODER_LIST[@]}"; do
      labels+=("${DECODER_LABEL[$d]}")
    done
    labels+=("$ADSB_MENU_LABEL")

    local selections
    selections=$(gum_multichoice "Select what to install" "${labels[@]}") || {
      info "Nothing selected"
      exit 0
    }

    SELECTED_DECODERS=()
    while IFS= read -r line; do
      [[ "$line" == "$ADSB_MENU_LABEL" ]] && WANT_ADSB=true
      for d in "${DECODER_LIST[@]}"; do
        if [[ "$line" == "${DECODER_LABEL[$d]}" ]]; then
          SELECTED_DECODERS+=("$d")
        fi
      done
    done <<< "$selections"
  else
    step "Select what to install"
    echo -e "  ${DIM}(Enter numbers separated by spaces, e.g., 1 3)${RESET}"
    echo

    local i=1
    for d in "${DECODER_LIST[@]}"; do
      echo -e "  ${CYAN}${i}${RESET})  ${DECODER_LABEL[$d]}"
      ((i++))
    done
    echo -e "  ${CYAN}5${RESET})  All four of the above"
    echo -e "  ${CYAN}6${RESET})  ${ADSB_MENU_LABEL}"
    echo

    local choices
    echo -ne "  ${BOLD}Select: ${RESET}"
    read -r choices || choices=""

    SELECTED_DECODERS=()
    for idx in $choices; do
      case "$idx" in
        5) SELECTED_DECODERS=("${DECODER_LIST[@]}") ;;
        6) WANT_ADSB=true ;;
        [1-4]) SELECTED_DECODERS+=("${DECODER_LIST[$((idx-1))]}") ;;
      esac
    done
    # de-duplicate (e.g. "1 5")
    if [ ${#SELECTED_DECODERS[@]} -gt 0 ]; then
      mapfile -t SELECTED_DECODERS < <(printf '%s\n' "${SELECTED_DECODERS[@]}" | awk '!seen[$0]++')
    fi
  fi

  if [ ${#SELECTED_DECODERS[@]} -eq 0 ] && [ "$WANT_ADSB" = false ]; then
    info "Nothing selected. Bye!"
    exit 0
  fi

  local picked=("${SELECTED_DECODERS[@]}")
  [ "$WANT_ADSB" = true ] && picked+=("adsb")
  ok "Selected: ${picked[*]}"
}

tui_select_method() {
  local methods=("Pre-built binaries (recommended)" "Compile from source" "Docker containers")

  local choice
  choice=$(ui_choose "Installation method:" "${methods[@]}")

  case "$choice" in
    *binaries*) SELECTED_METHOD="binary" ;;
    *source*)   SELECTED_METHOD="source" ;;
    *Docker*)   SELECTED_METHOD="docker" ;;
  esac

  ok "Method: ${SELECTED_METHOD}"
}

tui_select_region() {
  local regions=("North America" "Europe" "Asia / Pacific" "Global / Other")

  local choice
  choice=$(ui_choose "Select your region (for frequency defaults):" "${regions[@]}")

  case "$choice" in
    *America*)   SELECTED_REGION="north_america" ;;
    *Europe*)    SELECTED_REGION="europe" ;;
    *Asia*|*Pacific*) SELECTED_REGION="asia_pacific" ;;
    *Global*|*Other*) SELECTED_REGION="global" ;;
  esac

  ok "Region: ${SELECTED_REGION}"
}

tui_select_sdr() {
  # First try to detect SDRs
  detect_sdrs

  if [ ${#DETECTED_SDRS[@]} -gt 0 ]; then
    show_detected_sdrs
    echo

    local detected_type
    detected_type=$(get_sdr_type)

    if ui_confirm "Use detected SDR (${detected_type})?"; then
      SELECTED_SDR="$detected_type"
      return
    fi
  fi

  local sdrs=("RTL-SDR (most common)" "Airspy Mini/R2" "SDRplay RSP")

  local choice
  choice=$(ui_choose "Select your SDR type:" "${sdrs[@]}")

  case "$choice" in
    *RTL*)    SELECTED_SDR="rtlsdr" ;;
    *Airspy*) SELECTED_SDR="airspy" ;;
    *SDR*)    SELECTED_SDR="sdrplay" ;;
  esac

  ok "SDR: ${SELECTED_SDR}"
}

# The station ID from the station's page on airframes.io. Without it the feed
# lands on an anonymous station named after this machine.
tui_station_id() {
  [ -n "$STATION_IDENT" ] && return 0
  [ "$IS_TTY" = true ] && [ "$AUTO_YES" = false ] || return 0
  echo
  echo -e "  ${DIM}Add a station at https://app.airframes.io and copy its Station ID here.${RESET}"
  echo -e "  ${DIM}Leave it blank to feed without one (run again with --station-id later).${RESET}"
