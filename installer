nproc_count() {
  nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2
}

# Build platform-specific cmake flags (Homebrew prefix, macOS workarounds)
platform_cmake_flags() {
  local flags="-DCMAKE_POLICY_VERSION_MINIMUM=3.5"

  if [ "$OS" = "macos" ]; then
    local prefix
    prefix="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
    flags="${flags} -DCMAKE_PREFIX_PATH=${prefix}"
    flags="${flags} -DCMAKE_C_FLAGS=-DHOST_NAME_MAX=255"
    flags="${flags} -DCMAKE_INCLUDE_PATH=${prefix}/include"
    flags="${flags} -DCMAKE_LIBRARY_PATH=${prefix}/lib"
    flags="${flags} -DCMAKE_INSTALL_RPATH=/usr/local/lib;${prefix}/lib"
    flags="${flags} -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON"
    flags="${flags} -DCMAKE_MACOSX_RPATH=ON"
    flags="${flags} -DCMAKE_INSTALL_NAME_DIR=/usr/local/lib"
  fi

  echo "$flags"
}

# Set environment so the C compiler finds Homebrew headers/libs.
# C_INCLUDE_PATH and LIBRARY_PATH are Clang/GCC env vars that add search
# paths unconditionally, even when CMakeLists.txt overrides CMAKE_C_FLAGS.
platform_env_setup() {
  if [ "$OS" = "macos" ]; then
    local prefix
    prefix="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
    export C_INCLUDE_PATH="${prefix}/include${C_INCLUDE_PATH:+:${C_INCLUDE_PATH}}"
    export LIBRARY_PATH="${prefix}/lib${LIBRARY_PATH:+:${LIBRARY_PATH}}"
    export PKG_CONFIG_PATH="${prefix}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
  fi
}

install_base_deps() {
  step "Installing base build dependencies"
  pkg_update
  pkg_install build-essential cmake pkg-config git curl librtlsdr-dev libusb-dev
  platform_env_setup
}

install_decoder_deps() {
  local decoder="$1"

  local extra="${DECODER_EXTRA_DEPS[$decoder]:-}"
  if [ -n "$extra" ]; then
    substep "Installing ${decoder} dependencies"
    # shellcheck disable=SC2086
    pkg_install $extra
  fi

  # Remove conflicting packages
  local remove="${DECODER_REMOVE_PKGS[$decoder]:-}"
  if [ -n "$remove" ]; then
    for pkg in $remove; do
      substep "Removing conflicting package: ${pkg}"
      pkg_remove "$pkg"
    done
  fi
}

build_libacars() {
  if [ -f "$BUILD_DIR/.libacars_built" ]; then
    info "libacars already built, skipping"
    return 0
  fi

  step "Building libacars"
  api_report_status "building_libacars" "Building libacars dependency" 20

  mkdir -p "$BUILD_DIR"
  cd "$BUILD_DIR"

  if [ ! -d libacars ]; then
    git clone --depth 1 "$LIBACARS_REPO"
  fi

  cd libacars
  mkdir -p build && cd build
  # shellcheck disable=SC2086
  cmake .. $(platform_cmake_flags)
  make -j"$(nproc_count)"
  sudo make install

  if [ "$OS" = "linux" ]; then
    sudo ldconfig
  elif [ "$OS" = "macos" ]; then
    fix_macos_dylib_paths
  fi

  touch "$BUILD_DIR/.libacars_built"
  ok "libacars installed"
}

# Fix libacars dylib install name on macOS.
# CMake sets it to @rpath/libacars-2.2.dylib by default, but binaries
# linking against it won't have LC_RPATH entries. Use an absolute path instead.
fix_macos_dylib_paths() {
  local prefix
  prefix="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"

  for dylib in /usr/local/lib/libacars-2*.dylib; do
    if [ -f "$dylib" ] && [ ! -L "$dylib" ]; then
      local current_id
      current_id=$(otool -D "$dylib" | tail -1)
      if [[ "$current_id" == @rpath/* ]]; then
        substep "Fixing install name: ${dylib}"
        sudo install_name_tool -id "$dylib" "$dylib"
      fi
    fi
  done
}

# Fix rpath references in installed decoder binaries on macOS.
fix_macos_binary_rpaths() {
  local decoder="$1"
  local bin_path
  bin_path=$(command -v "$decoder" 2>/dev/null || echo "/usr/local/bin/${decoder}")

  if [ ! -f "$bin_path" ]; then
    return
  fi

  local prefix
  prefix="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"

  # Replace @rpath references to libacars with absolute paths
  local deps
  deps=$(otool -L "$bin_path" | grep '@rpath/' | awk '{print $1}')
  for dep in $deps; do
    local libname="${dep#@rpath/}"
    local resolved=""
    # Search in known lib dirs
    for dir in /usr/local/lib "${prefix}/lib"; do
      if [ -f "${dir}/${libname}" ]; then
        resolved="${dir}/${libname}"
        break
      fi
    done
    if [ -n "$resolved" ]; then
      substep "Fixing ${decoder}: ${dep} -> ${resolved}"
      sudo install_name_tool -change "$dep" "$resolved" "$bin_path"
    fi
  done

  # Also add rpath entries as fallback
  for rpath in /usr/local/lib "${prefix}/lib"; do
    if ! otool -l "$bin_path" | grep -A2 LC_RPATH | grep -q "$rpath"; then
      sudo install_name_tool -add_rpath "$rpath" "$bin_path" 2>/dev/null || true
    fi
  done
}

# Apply macOS compatibility patches to decoder sources.
patch_macos_sources() {
  local decoder="$1"

  case "$decoder" in
    acarsdec)
      # pthread_tryjoin_np is a Linux-only glibc extension.
      # Replace with pthread_join (POSIX-portable).
      for src in rtl.c soapy.c; do
        if [ -f "$src" ]; then
          sed -i.bak 's/pthread_tryjoin_np/pthread_join/g' "$src"
          rm -f "${src}.bak"
        fi
      done
      ;;
    vdlm2dec)
      # pthread_barrier_t doesn't exist on macOS. Add header-only polyfill.
      create_pthread_barrier_polyfill
      sed -i.bak '/#include <pthread.h>/a\
#ifndef PTHREAD_BARRIER_SERIAL_THREAD\
#include "pthread_barrier.h"\
#endif\
#include <complex.h>' vdlm2.h
      rm -f vdlm2.h.bak
      ;;
  esac
}

# Create header-only pthread_barrier polyfill for macOS (BSD-licensed).
# Uses static inline functions — no separate .c file or CMakeLists.txt changes needed.
create_pthread_barrier_polyfill() {
  cat > pthread_barrier.h << 'HEOF'
#ifndef _PTHREAD_BARRIER_H
#define _PTHREAD_BARRIER_H
#include <pthread.h>
#include <errno.h>
#ifndef PTHREAD_BARRIER_SERIAL_THREAD
#define PTHREAD_BARRIER_SERIAL_THREAD (-1)
typedef int pthread_barrierattr_t;
typedef struct {
    pthread_mutex_t mutex;
    pthread_cond_t  cond;
    unsigned int    limit;
    unsigned int    count;
    unsigned int    phase;
} pthread_barrier_t;
static inline int
pthread_barrier_init(pthread_barrier_t *barrier,
                     const pthread_barrierattr_t *attr, unsigned int count) {
    (void)attr;
    if (count == 0) { errno = EINVAL; return -1; }
    if (pthread_mutex_init(&barrier->mutex, NULL) != 0) return -1;
    if (pthread_cond_init(&barrier->cond, NULL) != 0) {
        int e = errno; pthread_mutex_destroy(&barrier->mutex); errno = e; return -1;
    }
    barrier->limit = count; barrier->count = 0; barrier->phase = 0;
    return 0;
}
static inline int
pthread_barrier_destroy(pthread_barrier_t *barrier) {
    pthread_cond_destroy(&barrier->cond);
    pthread_mutex_destroy(&barrier->mutex);
    return 0;
}
static inline int
pthread_barrier_wait(pthread_barrier_t *barrier) {
    pthread_mutex_lock(&barrier->mutex);
    barrier->count++;
    if (barrier->count >= barrier->limit) {
        barrier->phase++; barrier->count = 0;
        pthread_cond_broadcast(&barrier->cond);
        pthread_mutex_unlock(&barrier->mutex);
        return PTHREAD_BARRIER_SERIAL_THREAD;
    } else {
        unsigned int phase = barrier->phase;
        while (barrier->phase == phase)
            pthread_cond_wait(&barrier->cond, &barrier->mutex);
        pthread_mutex_unlock(&barrier->mutex);
        return 0;
    }
}
#endif
#endif
HEOF
}

compile_decoder() {
  local decoder="$1"
  local repo="${DECODER_REPO[$decoder]}"
  local sdr="${SELECTED_SDR:-rtlsdr}"
  local cmake_flags
  cmake_flags=$(get_cmake_flags_for_sdr "$decoder" "$sdr")

  step "Building ${decoder}"
  api_report_status "building_decoder" "Building ${decoder} from source" 50

  mkdir -p "$BUILD_DIR"
  cd "$BUILD_DIR"

  if [ -d "$decoder" ]; then
    rm -rf "$decoder"
  fi

  git clone --depth 1 "$repo" "$decoder"
  cd "$decoder"

  # Apply macOS-specific source patches
  if [ "$OS" = "macos" ]; then
    patch_macos_sources "$decoder"
  fi

  mkdir -p build && cd build
  # shellcheck disable=SC2086
  cmake .. $(platform_cmake_flags) $cmake_flags
  make -j"$(nproc_count)"
  sudo make install

  if [ "$OS" = "linux" ]; then
    sudo ldconfig
  elif [ "$OS" = "macos" ]; then
    fix_macos_binary_rpaths "$decoder"
  fi

  ok "${decoder} installed"
}

install_from_source() {
  local decoder="$1"

  install_decoder_deps "$decoder"
  build_libacars
  compile_decoder "$decoder"
}

