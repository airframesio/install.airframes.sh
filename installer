tui_select_sdr() {
  # First try to detect SDRs
  detect_sdrs

  if [ ${#DETECTED_SDRS[@]} -gt 0 ]; then
    show_detected_sdrs
    echo

    local detected_type
    detected_type=$(get_sdr_type)

    if ui_confirm "Use detected SDR (${detected_type})?"; then
      SELECTED_SDR="$detected_type"
      return
    fi
  fi

  local sdrs=("RTL-SDR (most common)" "Airspy Mini/R2" "SDRplay RSP")

  local choice
  choice=$(ui_choose "Select your SDR type:" "${sdrs[@]}")

  case "$choice" in
    *RTL*)    SELECTED_SDR="rtlsdr" ;;
    *Airspy*) SELECTED_SDR="airspy" ;;
    *SDR*)    SELECTED_SDR="sdrplay" ;;
  esac

  ok "SDR: ${SELECTED_SDR}"
}

# The station ID from the station's page on airframes.io. Without it the feed
# lands on an anonymous station named after this machine.
tui_station_id() {
  [ -n "$STATION_IDENT" ] && return 0
  [ "$IS_TTY" = true ] && [ "$AUTO_YES" = false ] || return 0
  echo
  echo -e "  ${DIM}Add a station at https://app.airframes.io and copy its Station ID here.${RESET}"
  echo -e "  ${DIM}Leave it blank to feed without one (run again with --station-id later).${RESET}"
  STATION_IDENT=$(ui_input "Station ID" "")
  STATION_IDENT="${STATION_IDENT//[[:space:]]/}"
}

tui_confirm_install() {
  echo
  step "Installation Summary"
  echo
  [ "$WANT_XNG" = true ] && xng_plan_lines
  if [ ${#SELECTED_DECODERS[@]} -gt 0 ]; then
    echo -e "  ${BOLD}Decoders:${RESET}  ${SELECTED_DECODERS[*]}"
    echo -e "  ${BOLD}Method:${RESET}    ${SELECTED_METHOD}"
    echo -e "  ${BOLD}Region:${RESET}    ${SELECTED_REGION}"
    echo -e "  ${BOLD}SDR:${RESET}       ${SELECTED_SDR}"
    if [ "$SELECTED_SDR" = "rtlsdr" ] && [ -n "$SDR_DEVICE" ]; then
      echo -e "  ${BOLD}Device:${RESET}    RTL-SDR $(sdr_device_label)"
    fi
  fi
  if [ "$WANT_ADSB" = true ]; then
    local partners="Airplanes.Live"
    [ -n "$PLANEWATCH_KEY" ] && partners+=", Plane Watch"
    local source="existing decoder on port 30005"
    xng_has_job adsb && source="xng"
    xng_has_job adsb || adsb_source_ready || source="new readsb"
    [ "$SELECTED_METHOD" = "docker" ] && ! adsb_source_ready && source="new ultrafeeder (Docker)"
    echo -e "  ${BOLD}ADS-B:${RESET}     ${partners} (from ${source})"
    echo -e "  ${BOLD}Antenna:${RESET}   ${ADSB_LAT}, ${ADSB_LON}, ${ADSB_ALT}  (MLAT name ${ADSB_NAME})"
  fi
  if [ -n "$STATION_IDENT" ] && [ "$WANT_XNG" = false ]; then
    echo -e "  ${BOLD}Station:${RESET}   ${STATION_IDENT}"
  fi
  echo

  if ! ui_confirm "Proceed with installation?"; then
    info "Aborted."
    exit 0
  fi
}

# Is systemd running here (not just installed, as in many containers)?
have_systemd() {
  [ "$OS" = "linux" ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

# CLI mode: run the decoder as a service unless --no-service. -y, or no
# terminal to ask, means yes: the person asked for the decoder to be set up.
cli_post_install() {
  local decoder="$1"
  [ "$SELECTED_METHOD" = "docker" ] && return 0
  if [ "$NO_SERVICE" = true ]; then
    show_run_command "$decoder"
    return 0
  fi
  if have_systemd; then
    if ui_confirm "Start ${decoder} now and on every boot (systemd service)?" "yes"; then
      create_systemd_service "$decoder"
      return 0
    fi
  elif [ "$OS" = "macos" ]; then
    if ui_confirm "Start ${decoder} now and at login (launchd service)?" "yes"; then
      create_launchd_service "$decoder"
      return 0
    fi
  else
    warn "systemd isn't running here, so ${decoder} won't start by itself."
  fi
  show_run_command "$decoder"
}

tui_post_install() {
  local decoder="$1"

  [ "$SELECTED_METHOD" = "docker" ] && return 0
  if [ "$NO_SERVICE" = true ]; then
    show_run_command "$decoder"
    return 0
  fi
  echo
  if have_systemd; then
    local actions=("Show run command" "Create systemd service (auto-start on boot)" "Both")
    local choice
    choice=$(ui_choose "How would you like to run ${decoder}?" "${actions[@]}")

    case "$choice" in
      *"Show run"*)
        show_run_command "$decoder"
        ;;
      *systemd*)
        create_systemd_service "$decoder"
        ;;
      *Both*)
        show_run_command "$decoder"
        create_systemd_service "$decoder"
        ;;
    esac
  elif [ "$OS" = "macos" ]; then
    local actions=("Show run command" "Create launchd service (auto-start on login)" "Both")
    local choice
    choice=$(ui_choose "How would you like to run ${decoder}?" "${actions[@]}")

    case "$choice" in
      *"Show run"*)
        show_run_command "$decoder"
        ;;
      *launchd*)
        create_launchd_service "$decoder"
        ;;
      *Both*)
        show_run_command "$decoder"
        create_launchd_service "$decoder"
        ;;
    esac
  else
    show_run_command "$decoder"
  fi
}

tui_flow() {
  show_banner

  # Detect platform
  info "Detected: ${OS} / ${ARCH} / ${DISTRO} / ${PKG}"
  if [ "$IS_WSL" = true ]; then
    info "Running under Windows Subsystem for Linux"
  fi
  echo

  # Install gum for TUI
  if [ "$USE_GUM" = true ]; then
    install_gum || { warn "Could not install gum, using plain menus"; HAS_GUM=false; }
  fi

  # ADS-B / decoders already on this machine
  check_existing_setup

  # What to set up
  tui_select_setup

  [ "$WANT_XNG" = true ] && plan_xng_station

  if [ ${#SELECTED_DECODERS[@]} -gt 0 ]; then
    tui_select_method
    tui_select_region
    tui_select_sdr
    check_sdr_for_decoders
    tui_station_id
  fi

  # ADS-B: antenna position, MLAT name, Plane Watch key
  if [ "$WANT_ADSB" = true ]; then
    [ -z "$ADSB_LAT" ] && ADSB_LAT="$STATION_LAT"
    [ -z "$ADSB_LON" ] && ADSB_LON="$STATION_LON"
    adsb_collect_location
  fi

  # Confirmation
  tui_confirm_install

  # Install
  if [ ${#SELECTED_DECODERS[@]} -gt 0 ]; then
    install_base_deps
    mkdir -p "$BUILD_DIR"
  fi

  for decoder in "${SELECTED_DECODERS[@]}"; do
    case "$SELECTED_METHOD" in
      source)  install_from_source "$decoder" ;;
      docker)  install_with_docker "$decoder" ;;
      binary)  install_from_binary "$decoder" ;;
      package) install_from_package "$decoder" ;;
    esac

    save_config "$decoder"
    tui_post_install "$decoder"
  done

  [ "$WANT_XNG" = true ] && { setup_xng_station || exit 1; }

  setup_adsb

  [ ${#SELECTED_DECODERS[@]} -gt 0 ] && install_manager_script

  [ "$WANT_XNG" = true ] && xng_summary
  closing_message
}

closing_message() {
  echo
  if [ "$WANT_XNG" = false ] && [ ${#SELECTED_DECODERS[@]} -eq 0 ] && [ "$WANT_ADSB" = true ]; then
    ok "Done! Thank you for feeding Airframes' ADS-B partners."
    info "For ACARS, VDL2 or airband voice on Airframes, add an SDR and run this again."
  else
    ok "Done! Thank you for feeding Airframes."
  fi
  info "Learn more at https://docs.airframes.io"
}

# ===========================================================================
# Section 21: Main entry point (mode dispatch)
# ===========================================================================

main() {
  if [ -t 0 ]; then IS_TTY=true; else IS_TTY=false; fi

  parse_args "$@"
  if [ "$WANT_XNG" = true ] && [ ${#SELECTED_DECODERS[@]} -gt 0 ]; then
    err "xng decodes ACARS, VDL2 and HFDL itself, and both would want the same SDRs."
    err "Pick xng or ${SELECTED_DECODERS[*]}, not both."
    exit 1
  fi
  detect_platform

  # Windows native (not WSL) — show guide and exit
  if [ "$OS" = "windows" ] && [ "$IS_WSL" = false ]; then
    show_banner
    echo
    warn "Native Windows is not directly supported."
    echo
    info "Options:"
    echo -e "  1. Install ${BOLD}WSL 2${RESET} (recommended): wsl --install"
    echo -e "  2. Use ${BOLD}Docker Desktop${RESET}: https://docker.com/products/docker-desktop"
    echo
    info "After installing WSL, run this installer again inside your WSL terminal."
    exit 0
  fi

  # Token mode: fetch config from API
  if [ -n "$TOKEN" ]; then
    show_banner
    info "Detected: ${OS} / ${ARCH} / ${DISTRO} / ${PKG}"
    echo

    api_fetch_config || exit 1

    if [ -z "$SELECTED_REGION" ]; then
      SELECTED_REGION=$(detect_region_from_timezone)
    fi

    check_existing_setup

    install_base_deps
    mkdir -p "$BUILD_DIR"

    for decoder in "${SELECTED_DECODERS[@]}"; do
      case "$SELECTED_METHOD" in
        source)  install_from_source "$decoder" ;;
        docker)  install_with_docker "$decoder" ;;
        binary)  install_from_binary "$decoder" ;;
        package) install_from_package "$decoder" ;;
      esac

      save_config "$decoder"

      api_report_status "configuring" "Configuring ${decoder}" 80
      show_run_command "$decoder"

      if [ "$NO_SERVICE" = true ]; then
        :
      elif have_systemd; then
        if [ "$AUTO_YES" = true ] || ui_confirm "Create systemd service for ${decoder}?"; then
          create_systemd_service "$decoder"
          api_report_status "feeding" "${decoder} is feeding" 95
        fi
      elif [ "$OS" = "macos" ]; then
        if [ "$AUTO_YES" = true ] || ui_confirm "Create launchd service for ${decoder}?"; then
          create_launchd_service "$decoder"
          api_report_status "feeding" "${decoder} is feeding" 95
        fi
      fi
    done

    install_manager_script
    api_report_status "complete" "Installation complete" 100
    echo
    ok "Done! Thank you for feeding Airframes."
    info "Your station will appear on the dashboard shortly."
    exit 0
  fi

  # CLI mode: decoder(s) passed as arguments
  if [ ${#SELECTED_DECODERS[@]} -gt 0 ] || [ "$WANT_ADSB" = true ] || [ "$WANT_XNG" = true ]; then
    show_banner
    info "Detected: ${OS} / ${ARCH} / ${DISTRO} / ${PKG}"
    echo

    if [ -z "$SELECTED_REGION" ]; then
      SELECTED_REGION=$(detect_region_from_timezone)
    fi

    check_existing_setup
    [ "$WANT_XNG" = true ] && plan_xng_station
    [ ${#SELECTED_DECODERS[@]} -gt 0 ] && check_sdr_for_decoders
    if [ "$WANT_ADSB" = true ]; then
      [ -z "$ADSB_LAT" ] && ADSB_LAT="$STATION_LAT"
      [ -z "$ADSB_LON" ] && ADSB_LON="$STATION_LON"
      adsb_collect_location
    fi

    if [ "$WANT_XNG" = true ]; then
      echo
      xng_plan_lines
    fi

    if [ "$AUTO_YES" = false ]; then
      local what=("${SELECTED_DECODERS[@]}")
      [ "$WANT_XNG" = true ] && what=("the xng station ${STATION_IDENT}" "${what[@]}")
      [ "$WANT_ADSB" = true ] && what+=("ADS-B feeds for Airplanes.Live${PLANEWATCH_KEY:+ and Plane Watch}")
      if ! ui_confirm "Install $(join_by ', ' "${what[@]}")?"; then
        info "Aborted."
        exit 0
      fi
    fi

    if [ ${#SELECTED_DECODERS[@]} -gt 0 ]; then
      install_base_deps
      mkdir -p "$BUILD_DIR"
    fi

    for decoder in "${SELECTED_DECODERS[@]}"; do
      case "$SELECTED_METHOD" in
        source)  install_from_source "$decoder" ;;
        docker)  install_with_docker "$decoder" ;;
        binary)  install_from_binary "$decoder" ;;
        package) install_from_package "$decoder" ;;
      esac

      save_config "$decoder"
      cli_post_install "$decoder"
    done

    [ "$WANT_XNG" = true ] && { setup_xng_station || exit 1; }

    setup_adsb

    [ ${#SELECTED_DECODERS[@]} -gt 0 ] && install_manager_script

    [ "$WANT_XNG" = true ] && xng_summary
    closing_message
    exit 0
  fi

  # TUI mode: no args, interactive
  if [ "$IS_TTY" = true ]; then
    tui_flow
  else
    # No terminal to ask on (cron, CI, ssh without -t, docker without -t)
    # and no decoder named. Say exactly what to run instead.
    show_banner
    detect_existing_setup
    show_existing_setup
    echo
    echo -e "${RED}[airframes]${RESET} There is no terminal to ask questions on, and no decoder was named."
    echo
    echo "  Run it from a terminal to pick from a menu:"
    echo "    curl -sSL https://install.airframes.sh/installer | bash"
    echo
    echo "  Or set up an xng station on every SDR here (recommended):"
    echo "    curl -sSL https://install.airframes.sh/installer | bash -s -- -y xng"
    echo
    echo "  Or name decoders to install (acarsdec, dumpvdl2, dumphfdl, vdlm2dec or all):"
    echo "    curl -sSL https://install.airframes.sh/installer | bash -s -- -y acarsdec"
    echo
    echo "  ADS-B, fed to Airframes' partners Airplanes.Live and Plane Watch:"
    echo "    curl -sSL https://install.airframes.sh/installer | bash -s -- -y adsb --lat 38.68 --lon -120.99 --alt 120m"
    echo
    echo "  More options: curl -sSL https://install.airframes.sh/installer | bash -s -- --help"
    exit 1
  fi
}

# Entry point. With "curl ... | bash", bash reads this script from stdin, so
# prompts would read the script instead of the keyboard. When a terminal is
# there (/dev/tty opens), give main() the terminal as stdin; bash keeps
# reading the rest of the script (only "exit" below) from the pipe.
# AIRFRAMES_NO_TTY=1 skips this, for tests and automation.
if [ ! -t 0 ] && [ -z "${AIRFRAMES_NO_TTY:-}" ] && { : </dev/tty; } 2>/dev/null; then
  main "$@" </dev/tty
else
  main "$@"
fi
exit $?
