usage() {
  cat << EOF
Airframes Installer v${VERSION}

Usage: installer [OPTIONS] [WHAT...]

With no WHAT, it asks what to set up.

What to set up:
  xng         Recommended. One xng station runs every SDR here (ACARS, VDL2,
              HFDL, AIS, airband voice, ADS-B, ...) and feeds Airframes.
  acarsdec    VHF ACARS decoder
  dumpvdl2    VDL Mode 2 decoder
  dumphfdl    HF Data Link decoder
  vdlm2dec    VDL Mode 2 decoder (alternative)
  all         Install all decoders
  adsb        ADS-B (1090 MHz) for Airframes' partners Airplanes.Live and
              Plane Watch (Airframes doesn't ingest ADS-B itself). Uses the
              ADS-B decoder already running, or installs readsb.

Options:
  -h, --help              Show this help message
  -v, --version           Show version
  -y, --yes               Skip confirmation prompts (automated mode)
  --token TOKEN           Use station token from web wizard
  --region REGION         Set region (north_america, europe, asia_pacific)
  --sdr TYPE              Set SDR type (rtlsdr, airspy, sdrplay)
  --device ID             RTL-SDR to use, by index or serial (default: the
                          first one an ADS-B decoder isn't using)
  --method METHOD         Install method (binary, source, docker)
  --no-tui                Disable gum TUI, use plain menus
  --no-service            Don't offer to create systemd service
  --freq "F1 F2 ..."      Override frequencies
  --station-id ID         Station ID from your station page on airframes.io

xng options:
  --sign-in               Sign in to Airframes (device code) even with -y
  --no-sign-in            Don't sign in; the feed still counts, unclaimed
  --modes "S=MODE,..."    Job per SDR, by serial or number: acars, vdl2, hfdl,
                          airband, ais, adsb, uat, sonde, iridium or off
  --airband "MHZ,..."     Airband channels (must be in the Airframes ATC
                          directory near you), or "nearest" (default)
  --xng-method METHOD     native or docker (default: native, else Docker)
  --xng-version VER       xng version (default: latest release)
  --lat / --lon           Receiver position (also used for ADS-B)

ADS-B options:
  --lat DEG / --lon DEG   Antenna position, decimal degrees
  --alt ALT               Antenna altitude, e.g. 120m or 394ft
  --mlat-name NAME        Name on the MLAT map (default: hostname)
  --planewatch-key KEY    Also feed Plane Watch (key from atc.plane.watch)
  --adsb-device ID        RTL-SDR for a new ADS-B decoder (index or serial)

Examples:
  curl -sSL https://install.airframes.sh/installer | bash
  curl -sSL https://install.airframes.sh/installer | bash -s -- -y xng --sign-in --lat 38.68 --lon -120.99
  curl -sSL https://install.airframes.sh/installer | bash -s -- -y xng --no-sign-in --modes "0=acars,1=vdl2"
  curl -sSL https://install.airframes.sh/installer | bash -s -- acarsdec
  curl -sSL https://install.airframes.sh/installer | bash -s -- -y acarsdec --station-id MY-STATION
  curl -sSL https://install.airframes.sh/installer | bash -s -- --token abc123
  curl -sSL https://install.airframes.sh/installer | bash -s -- -y all --region north_america
  curl -sSL https://install.airframes.sh/installer | bash -s -- dumpvdl2 --device 00000002
  curl -sSL https://install.airframes.sh/installer | bash -s -- -y adsb --lat 38.68 --lon -120.99 --alt 120m

Airframes collects ACARS, VDL2, HFDL, AIS and airband voice. ADS-B goes to Airframes' partner
networks. On a PiAware or other ADS-B box, "adsb" adds those feeds from the
decoder you already run; ACARS/VDL2/HFDL need a second SDR.
EOF
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -v|--version)
        echo "Airframes Installer v${VERSION}"
        exit 0
        ;;
      -y|--yes)
        AUTO_YES=true
        shift
        ;;
      --token)
        TOKEN="$2"
        shift 2
        ;;
      --region)
        SELECTED_REGION="$2"
        shift 2
        ;;
      --sdr)
        SELECTED_SDR="$2"
        shift 2
        ;;
      --method)
        SELECTED_METHOD="$2"
        shift 2
        ;;
      --device)
        SDR_DEVICE="$2"
        SDR_DEVICE_SET_BY_USER=true
        shift 2
        ;;
      --no-tui)
        USE_GUM=false
        shift
        ;;
      --no-service)
        CREATE_SERVICE=false
        NO_SERVICE=true
        SHOW_RUN_CMD=true
        shift
        ;;
      --freq)
        FREQUENCIES="$2"
        shift 2
        ;;
      --station-id)
        STATION_IDENT="$2"
        shift 2
        ;;
      acarsdec|dumpvdl2|dumphfdl|vdlm2dec)
        SELECTED_DECODERS+=("$1")
        shift
        ;;
      all)
        SELECTED_DECODERS=("${DECODER_LIST[@]}")
        shift
        ;;
      adsb|ads-b|ADSB)
        WANT_ADSB=true
        shift
        ;;
      xng|station)      WANT_XNG=true; shift ;;
      --sign-in)        SIGNIN_MODE=yes; shift ;;
      --no-sign-in)     SIGNIN_MODE=no; shift ;;
      --modes)          XNG_MODES_ARG="$2"; WANT_XNG=true; shift 2 ;;
      --airband)        XNG_AIRBAND_ARG="$2"; WANT_XNG=true; shift 2 ;;
      --xng-method)
        case "$2" in native|docker) XNG_METHOD="$2" ;; *) err "--xng-method: native or docker"; exit 1 ;; esac
        WANT_XNG=true; shift 2 ;;
      --xng-version)    XNG_VERSION="${2#v}"; WANT_XNG=true; shift 2 ;;
      --lat)            ADSB_LAT="$2"; shift 2 ;;
      --lon)            ADSB_LON="$2"; shift 2 ;;
      --alt)            ADSB_ALT="$2"; shift 2 ;;
      --mlat-name)      ADSB_NAME="$2"; shift 2 ;;
      --planewatch-key) PLANEWATCH_KEY="$2"; shift 2 ;;
      --adsb-device)    ADSB_SDR_DEVICE="$2"; shift 2 ;;
      *)
        err "Unknown argument: $1"
        usage
        exit 1
        ;;
    esac
  done
}

