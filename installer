parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -v|--version)
        echo "Airframes Installer v${VERSION}"
        exit 0
        ;;
      -y|--yes)
        AUTO_YES=true
        shift
        ;;
      --token)
        TOKEN="$2"
        shift 2
        ;;
      --region)
        SELECTED_REGION="$2"
        shift 2
        ;;
      --sdr)
        SELECTED_SDR="$2"
        shift 2
        ;;
      --method)
        SELECTED_METHOD="$2"
        shift 2
        ;;
      --device)
        SDR_DEVICE="$2"
        SDR_DEVICE_SET_BY_USER=true
        shift 2
        ;;
      --no-tui)
        USE_GUM=false
        shift
        ;;
      --no-service)
        CREATE_SERVICE=false
        NO_SERVICE=true
        SHOW_RUN_CMD=true
        shift
        ;;
      --freq)
        FREQUENCIES="$2"
        shift 2
        ;;
      --station-id)
        STATION_IDENT="$2"
        shift 2
        ;;
      acarsdec|dumpvdl2|dumphfdl|vdlm2dec)
        SELECTED_DECODERS+=("$1")
        shift
        ;;
      all)
        SELECTED_DECODERS=("${DECODER_LIST[@]}")
        shift
        ;;
      adsb|ads-b|ADSB)
        WANT_ADSB=true
        shift
        ;;
      xng|station)      WANT_XNG=true; shift ;;
      status|doctor)    COMMAND=status; shift ;;
      update|upgrade)   COMMAND=update; shift ;;
      uninstall|remove) COMMAND=uninstall; shift ;;
      --purge)          PURGE=true; shift ;;
      signin|sign-in|login) COMMAND=signin; shift ;;
      restore-decoders|switch-back) COMMAND=restoredecoders; shift ;;
      migrate)          WANT_XNG=true; shift ;;
      --keep-old-decoders) KEEP_OLD_DECODERS=true; WANT_XNG=true; shift ;;
      auto-update|autoupdate)
        COMMAND=autoupdate; shift
        case "${1:-}" in on|yes) AUTO_UPDATE=yes; shift ;; off|no) AUTO_UPDATE=no; shift ;; esac ;;
      --auto-update)    AUTO_UPDATE=yes; shift ;;
      --no-auto-update) AUTO_UPDATE=no; shift ;;
      --sign-in)        SIGNIN_MODE=yes; shift ;;
      --no-sign-in)     SIGNIN_MODE=no; shift ;;
      --modes)          XNG_MODES_ARG="$2"; WANT_XNG=true; shift 2 ;;
      --airband)        XNG_AIRBAND_ARG="$2"; WANT_XNG=true; shift 2 ;;
      --xng-method)
        case "$2" in native|docker) XNG_METHOD="$2" ;; *) err "--xng-method: native or docker"; exit 1 ;; esac
        WANT_XNG=true; shift 2 ;;
      --xng-version)    XNG_VERSION="${2#v}"; WANT_XNG=true; shift 2 ;;
      --lat)            ADSB_LAT="$2"; shift 2 ;;
      --lon)            ADSB_LON="$2"; shift 2 ;;
      --alt)            ADSB_ALT="$2"; shift 2 ;;
      --mlat-name)      ADSB_NAME="$2"; shift 2 ;;
      --planewatch-key) PLANEWATCH_KEY="$2"; shift 2 ;;
      --adsb-device)    ADSB_SDR_DEVICE="$2"; shift 2 ;;
      *)
        err "Unknown argument: $1"
        usage
        exit 1
        ;;
    esac
  done
}

