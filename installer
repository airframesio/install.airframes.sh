# USB VID:PID database
declare -A SDR_VIDPID_MAP=(
  ["0bda:2838"]="rtlsdr"
  ["0bda:2832"]="rtlsdr"
  ["1d50:604b"]="airspy"
  ["1d50:60a1"]="airspy_hf"
  ["1df7:2500"]="sdrplay"
  ["1df7:3000"]="sdrplay"
  ["1df7:3010"]="sdrplay"
  ["1df7:3020"]="sdrplay"
  ["1df7:3030"]="sdrplay"
)

declare -A SDR_VIDPID_NAMES=(
  ["0bda:2838"]="RTL-SDR (RTL2838)"
  ["0bda:2832"]="RTL-SDR (RTL2832)"
  ["1d50:604b"]="Airspy Mini/R2"
  ["1d50:60a1"]="Airspy HF+"
  ["1df7:2500"]="SDRplay RSP1"
  ["1df7:3000"]="SDRplay RSP1A"
  ["1df7:3010"]="SDRplay RSP2"
  ["1df7:3020"]="SDRplay RSPduo"
  ["1df7:3030"]="SDRplay RSPdx"
)

detect_sdrs() {
  DETECTED_SDRS=()

  if [ "$OS" = "linux" ]; then
    if ! command -v lsusb >/dev/null 2>&1; then
      return
    fi

    local lsusb_output
    lsusb_output=$(lsusb 2>/dev/null) || return

    for vidpid in "${!SDR_VIDPID_MAP[@]}"; do
      if echo "$lsusb_output" | grep -qi "$vidpid"; then
        local sdr_type="${SDR_VIDPID_MAP[$vidpid]}"
        local sdr_name="${SDR_VIDPID_NAMES[$vidpid]}"
        DETECTED_SDRS+=("${sdr_type}:${sdr_name}")
      fi
    done

  elif [ "$OS" = "macos" ]; then
    local usb_output
    usb_output=$(system_profiler SPUSBDataType 2>/dev/null) || return

    # Check for known product names
    if echo "$usb_output" | grep -qi "RTL2838\|RTL2832\|RTL-SDR"; then
      DETECTED_SDRS+=("rtlsdr:RTL-SDR")
    fi
    if echo "$usb_output" | grep -qi "Airspy"; then
      DETECTED_SDRS+=("airspy:Airspy")
    fi
    if echo "$usb_output" | grep -qi "SDRplay"; then
      DETECTED_SDRS+=("sdrplay:SDRplay")
    fi
  fi
}

show_detected_sdrs() {
  if [ ${#DETECTED_SDRS[@]} -eq 0 ]; then
    warn "No SDR devices detected"
    info "Make sure your SDR is plugged in via USB"
    return 1
  fi

  ok "Detected SDR devices:"
  for sdr in "${DETECTED_SDRS[@]}"; do
    local sdr_name="${sdr#*:}"
    echo -e "  ${GREEN}●${RESET} ${sdr_name}"
  done
  return 0
}

get_sdr_type() {
  if [ ${#DETECTED_SDRS[@]} -gt 0 ]; then
    # Return the type of the first detected SDR
    local first="${DETECTED_SDRS[0]}"
    echo "${first%%:*}"
  else
    echo "rtlsdr"
  fi
}

# --- Software already on this machine -------------------------------------
#
# Many people run this on a box that already feeds ADS-B (PiAware, readsb,
# FR24, ...). Airframes takes ACARS, VDL2 and HFDL, not ADS-B, so the decoder
# installed here needs an SDR of its own, and must not grab the dongle the
# ADS-B decoder is using.

process_running() {
  local name="$1"
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$name" 2>/dev/null; then
    return 0
  fi
  # Process names in /proc are cut to 15 characters
  grep -qxF "${name:0:15}" /proc/[0-9]*/comm 2>/dev/null
}

# RTL-SDR serial numbers in librtlsdr's index order. rtl_test lists them in
# that order (even ones another program holds); without it, sysfs gives the
# USB bus order, which is usually but not always the same.
detect_rtlsdr_serials() {
  RTLSDR_SERIALS=()
  RTLSDR_ORDER_KNOWN=false
  if [ -z "${AIRFRAMES_SYSFS_USB:-}" ] && command -v rtl_test >/dev/null 2>&1; then
    local line
    while IFS= read -r line; do
      # "  0:  Realtek, RTL2838UHIDIR, SN: 00001090"
      if [[ "$line" =~ ^[[:space:]]*[0-9]+:.*SN:[[:space:]]*([^[:space:]]*) ]]; then
        RTLSDR_SERIALS+=("${BASH_REMATCH[1]:-unknown}")
      fi
    done < <(timeout 5 rtl_test -d 9999 2>&1 || true)
    if [ ${#RTLSDR_SERIALS[@]} -gt 0 ]; then
      RTLSDR_ORDER_KNOWN=true
      return 0
    fi
  fi
  local usb="${AIRFRAMES_SYSFS_USB:-/sys/bus/usb/devices}"
  [ -d "$usb" ] || return 0
  local dev vid pid serial
  for dev in "$usb"/*; do
    [ -f "$dev/idVendor" ] && [ -f "$dev/idProduct" ] || continue
    vid=$(cat "$dev/idVendor" 2>/dev/null) || continue
    pid=$(cat "$dev/idProduct" 2>/dev/null) || continue
    case "${vid}:${pid}" in
      0bda:2838|0bda:2832)
        serial=$(cat "$dev/serial" 2>/dev/null || true)
        RTLSDR_SERIALS+=("${serial:-unknown}")
        ;;
    esac
  done
}

# RTL-SDR devices (index or serial) that ADS-B decoder configs ask for.
detect_adsb_devices() {
  ADSB_DEVICES=()
  local f line
  for f in /etc/default/dump1090-fa /etc/default/dump978-fa /etc/default/readsb \
           /etc/default/dump1090-mutability /etc/default/dump1090 \
           /boot/piaware-config.txt /boot/firmware/piaware-config.txt; do
    [ -r "$f" ] || continue
    while IFS= read -r line; do
      line="${line%%#*}"
      # RECEIVER_SERIAL=00001090, --device 1090, --device-index 0,
      # --sdr driver=rtlsdr,serial=00000978, rtlsdr-device-index 0
      if [[ "$line" =~ RECEIVER_SERIAL=\"?([A-Za-z0-9._-]+) ]] ||
         [[ "$line" =~ --device(-index)?[=[:space:]]+\"?([A-Za-z0-9._-]+) ]] ||
         [[ "$line" =~ serial=([A-Za-z0-9._-]+) ]] ||
         [[ "$line" =~ rtlsdr-device-index[[:space:]]+([0-9]+) ]]; then
        local m="${BASH_REMATCH[${#BASH_REMATCH[@]}-1]}"
        [ -n "$m" ] && ADSB_DEVICES+=("$m")
      fi
    done < "$f"
  done
}

detect_existing_setup() {
  ADSB_SOFTWARE=()
  ACARS_SOFTWARE=()
  [ "$OS" = "linux" ] || return 0

  local name
  for name in piaware dump1090-fa dump1090-mutability dump1090 readsb dump978-fa \
              fr24feed rbfeeder pfclient adsbexchange-feed mlat-client tar1090; do
    process_running "$name" && ADSB_SOFTWARE+=("$name")
  done
  for name in acarsdec dumpvdl2 dumphfdl vdlm2dec acars_router; do
    process_running "$name" && ACARS_SOFTWARE+=("$name")
  done

  # Docker setups (sdr-enthusiasts ultrafeeder, ACARS Hub, ...), if docker
  # can be asked without a password.
  if command -v docker >/dev/null 2>&1; then
    local line
    while IFS= read -r line; do
      case "$line" in
        *ultrafeeder*|*readsb*|*piaware*|*dump978*|*fr24*|*tar1090*|*adsb*)
          ADSB_SOFTWARE+=("docker:${line%% *}") ;;
        *acarshub*|*acarsdec*|*dumpvdl2*|*dumphfdl*|*vdlm2dec*|*acars_router*)
          ACARS_SOFTWARE+=("docker:${line%% *}") ;;
      esac
    done < <(timeout 5 docker ps --format '{{.Names}} {{.Image}}' 2>/dev/null || true)
  fi

  detect_rtlsdr_serials
  detect_adsb_devices
}

# Is this RTL-SDR (index $1, serial $2) one an ADS-B decoder is set to use?
rtlsdr_used_by_adsb() {
  local idx="$1" serial="$2" d
  for d in "${ADSB_DEVICES[@]}"; do
    [ "$d" = "$idx" ] && return 0
    [ "$d" = "$serial" ] && return 0
  done
  # Common naming for dedicated ADS-B / UAT dongles
  case "$serial" in
    *1090*|*978*) return 0 ;;
  esac
  return 1
}

# Choose which RTL-SDR the Airframes decoder should open, leaving the ADS-B
# dongle alone. Sets SDR_DEVICE to an index (librtlsdr numbering).
# Returns 1 when ADS-B appears to use every RTL-SDR, 2 when ADS-B runs but
# we can't tell which dongle it holds.
pick_sdr_device() {
  if [ "$SDR_DEVICE_SET_BY_USER" = true ]; then
    resolve_sdr_device
    return 0
  fi
  [ "${SELECTED_SDR:-rtlsdr}" = "rtlsdr" ] || return 0

  local count=${#RTLSDR_SERIALS[@]}
  if [ "$count" -eq 0 ]; then
    SDR_DEVICE="0"
    resolve_sdr_device
    return 0
  fi

  local adsb_active=false
  { [ ${#ADSB_SOFTWARE[@]} -gt 0 ] || [ "$WANT_ADSB" = true ]; } && adsb_active=true

  local i free_idx="" claimed=0
  for i in "${!RTLSDR_SERIALS[@]}"; do
    if [ "$adsb_active" = true ] && rtlsdr_used_by_adsb "$i" "${RTLSDR_SERIALS[$i]}"; then
      claimed=$((claimed + 1))
      continue
    fi
    [ -z "$free_idx" ] && free_idx="$i"
  done

  if [ -z "$free_idx" ]; then
    SDR_DEVICE=""
    return 1
  fi

  # A running ADS-B decoder holds one of several dongles: be sure which.
  if [ ${#ADSB_SOFTWARE[@]} -gt 0 ] && [ "$count" -ge 2 ]; then
    # Nothing names the ADS-B dongle (Docker, or a config without a device)
    [ "$claimed" -eq 0 ] && return 2
    # A config names it by index, and the index order is a guess
    if [ "$RTLSDR_ORDER_KNOWN" != true ]; then
      local d s known
      for d in "${ADSB_DEVICES[@]}"; do
        [[ "$d" =~ ^[0-9]+$ ]] || continue
        known=false
        for s in "${RTLSDR_SERIALS[@]}"; do [ "$s" = "$d" ] && known=true; done
        [ "$known" = true ] || return 2
      done
    fi
  fi

  SDR_DEVICE="$free_idx"
  resolve_sdr_device
  return 0
}

# Is serial $1 one only one dongle has?
rtlsdr_serial_unique() {
  local s="$1"
  [ -n "$s" ] && [ "$s" != "unknown" ] || return 1
  [ "$(printf '%s\n' "${RTLSDR_SERIALS[@]}" | grep -cxF -- "$s")" -eq 1 ]
}

# Split SDR_DEVICE (an index or a serial) into SDR_INDEX and SDR_SERIAL,
# each empty when unknown.
resolve_sdr_device() {
  SDR_INDEX=""
  SDR_SERIAL=""
  local dev="$SDR_DEVICE" i
  [ -n "$dev" ] || return 0
  # A serial wins over an index: "00000001" is a serial when a dongle has it
  for i in "${!RTLSDR_SERIALS[@]}"; do
    if [ "${RTLSDR_SERIALS[$i]}" = "$dev" ]; then
      SDR_SERIAL="$dev"
      rtlsdr_serial_unique "$dev" && SDR_INDEX="$i"
      return 0
    fi
  done
  if [[ "$dev" =~ ^[0-9]+$ ]]; then
    SDR_INDEX="$dev"
    if [ "$dev" -lt ${#RTLSDR_SERIALS[@]} ] && rtlsdr_serial_unique "${RTLSDR_SERIALS[$dev]}"; then
      SDR_SERIAL="${RTLSDR_SERIALS[$dev]}"
    fi
  else
    SDR_SERIAL="$dev"
  fi
}

# What to pass to acarsdec -r, vdlm2dec -r, dumpvdl2 --rtlsdr and readsb
# --device. They read an all-digit value as an index, so a serial such as
# 00000001 is only passed when it has a letter in it.
rtl_device_arg() {
  if [ -n "$SDR_SERIAL" ] && [[ ! "$SDR_SERIAL" =~ ^[0-9]+$ ]]; then
    echo "$SDR_SERIAL"
  elif [ -n "$SDR_INDEX" ]; then
    echo "$SDR_INDEX"
  elif [ -n "$SDR_SERIAL" ]; then
    echo "$SDR_SERIAL"
  else
    echo "0"
  fi
}

# SoapySDR (dumphfdl) picks an RTL-SDR by serial only.
soapy_rtl_arg() {
  if [ -n "$SDR_SERIAL" ]; then
    echo "driver=rtlsdr,serial=${SDR_SERIAL}"
  else
    echo "driver=rtlsdr"
  fi
}

# For messages: "0 (serial 00000001)"
sdr_device_label() {
  if [ -n "$SDR_INDEX" ] && [ -n "$SDR_SERIAL" ]; then
    echo "${SDR_INDEX} (serial ${SDR_SERIAL})"
  elif [ -n "$SDR_SERIAL" ]; then
    echo "serial ${SDR_SERIAL}"
  else
    echo "${SDR_INDEX:-0}"
  fi
}

join_by() {
  local sep="$1" out="" item
  shift
  for item in "$@"; do out+="${out:+$sep}${item}"; done
  echo "$out"
}

# Explain what is already on the machine.
show_existing_setup() {
  if [ ${#ADSB_SOFTWARE[@]} -gt 0 ]; then
    echo
    info "Found ADS-B software on this machine: ${BOLD}$(join_by ', ' "${ADSB_SOFTWARE[@]}")${RESET}"
    echo -e "  Airframes doesn't ingest ADS-B itself; it goes to Airframes' partners"
    echo -e "  ${BOLD}Airplanes.Live${RESET} and ${BOLD}Plane Watch${RESET}, from the decoder you already run."
    echo -e "  ACARS, VDL2, HFDL and airband voice for Airframes need another SDR."
  fi

  if [ ${#ACARS_SOFTWARE[@]} -gt 0 ]; then
    echo
    info "Found ACARS/VDL2/HFDL software already running: ${BOLD}$(join_by ', ' "${ACARS_SOFTWARE[@]}")${RESET}"
    echo -e "  If it already decodes, you can feed Airframes from it without reinstalling:"
    echo -e "  ${DIM}https://docs.airframes.io/docs/feeding/how${RESET}"
  fi
  return 0
}

check_existing_setup() {
  detect_existing_setup
  show_existing_setup
}

# Once the decoders are chosen: pick the RTL-SDR for the ACARS/VDL2/HFDL
# decoders, leaving ADS-B dongles alone. Asks when it can't tell; an
# unattended run stops instead of guessing (--device overrides).
check_sdr_for_decoders() {
  [ ${#SELECTED_DECODERS[@]} -gt 0 ] || return 0
  if [ "${SELECTED_SDR:-rtlsdr}" != "rtlsdr" ]; then
    [ -n "$SDR_DEVICE" ] || SDR_DEVICE="0"
    return 0
  fi

  local interactive=false
  [ "$IS_TTY" = true ] && [ "$AUTO_YES" = false ] && interactive=true

  local rc=0
  pick_sdr_device || rc=$?
  local n=${#RTLSDR_SERIALS[@]}

  if [ "$rc" -eq 2 ]; then
    warn "Found ${n} RTL-SDRs and ADS-B software (${ADSB_SOFTWARE[*]}), but can't tell which dongle ADS-B uses."
    if [ "$interactive" = true ]; then
      local -a opts=()
      local i
      for i in "${!RTLSDR_SERIALS[@]}"; do
        opts+=("Device ${i}, serial ${RTLSDR_SERIALS[$i]}")
      done
      local pick
      pick=$(ui_choose "Which RTL-SDR should ${SELECTED_DECODERS[*]} use (not the ADS-B one)?" "${opts[@]}")
      pick="${pick#Device }"
      SDR_DEVICE="${pick%%,*}"
      resolve_sdr_device
      ok "${SELECTED_DECODERS[*]} will use RTL-SDR $(sdr_device_label)"
      return 0
    fi
    err "Stopped so the ADS-B dongle isn't taken. Pass --device <index|serial> to choose one."
    exit 1
  fi

  # A new ADS-B decoder installed in this run needs a dongle too
  local adsb_needs_sdr=false
  if [ "$WANT_ADSB" = true ] && ! adsb_source_ready; then
    adsb_needs_sdr=true
  fi

  local blocked=false
  if [ "$rc" -eq 1 ]; then
    warn "Found ${n} RTL-SDR(s) (serial $(join_by ', ' "${RTLSDR_SERIALS[@]}")), and ADS-B appears to use all of them."
    warn "Plug in another SDR for ${SELECTED_DECODERS[*]}, or pass --device <index|serial> if this is wrong."
    blocked=true
  elif [ "$adsb_needs_sdr" = true ] && [ "$n" -lt 2 ] && [ "$SDR_DEVICE_SET_BY_USER" = false ]; then
    warn "ADS-B and ${SELECTED_DECODERS[*]} each need their own SDR, and only ${n} RTL-SDR is plugged in."
    blocked=true
  elif [ "$SDR_DEVICE_SET_BY_USER" = true ]; then
    info "${SELECTED_DECODERS[*]} will use RTL-SDR $(sdr_device_label), as set with --device."
  elif [ "$n" -gt 0 ] && { [ ${#ADSB_SOFTWARE[@]} -gt 0 ] || [ "$adsb_needs_sdr" = true ]; }; then
    ok "RTL-SDRs: $(join_by ', ' "${RTLSDR_SERIALS[@]}"). ${SELECTED_DECODERS[*]} will use $(sdr_device_label), leaving ADS-B its own."
  fi

  if [ "$blocked" = true ]; then
    if [ "$interactive" = true ]; then
      echo
      if ! ui_confirm "Install anyway (you can plug in another SDR later)?" "yes"; then
        info "Stopped. Nothing was installed."
        exit 0
      fi
    else
      err "Stopped so the ADS-B dongle isn't taken. Pass --device <index|serial> to use one anyway."
      exit 1
    fi
  fi
  [ -n "$SDR_DEVICE" ] || SDR_DEVICE="0"
  resolve_sdr_device
  if [[ " ${SELECTED_DECODERS[*]} " == *" dumphfdl "* ]] && [ -z "$SDR_SERIAL" ] && [ "${SDR_INDEX:-0}" != "0" ]; then
    warn "dumphfdl (SoapySDR) picks an RTL-SDR by serial, and the serial of device ${SDR_INDEX} isn't known."
    warn "It will open the first free RTL-SDR; pass --device <serial> to be sure."
  fi
  return 0
}

# ===========================================================================
# Section 8b: ADS-B for Airframes' partner networks
# ===========================================================================
#
# Airframes does not ingest ADS-B. When asked for "adsb", this installer
# feeds Airframes' ADS-B partners instead:
#   - Airplanes.Live: their feed client (github.com/airplanes-live/feed),
#     Beast to feed.airplanes.live:30004 and MLAT to :31090. On the docker
#     path, ultrafeeder sends both itself.
#   - Plane Watch: their docker feeder, which needs an API key from
#     https://atc.plane.watch.
# The Beast data comes from the ADS-B decoder already on the machine
# (127.0.0.1:30005), or from readsb (wiedehopf's installer) or ultrafeeder
# installed here when there is none.

AIRPLANES_LIVE_REPO="https://github.com/airplanes-live/feed.git"
AIRPLANES_LIVE_DIR="/usr/local/share/airplanes"
READSB_INSTALL_URL="https://raw.githubusercontent.com/wiedehopf/adsb-scripts/master/readsb-install.sh"
PLANEWATCH_IMAGE="ghcr.io/plane-watch/docker-plane-watch:latest"
ULTRAFEEDER_IMAGE="ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder:latest"

# Is a Beast stream already served on 127.0.0.1:30005?
adsb_source_ready() {
  [ "${XNG_SERVES_BEAST:-false}" = true ] && return 0
  (exec 3<>/dev/tcp/127.0.0.1/30005) 2>/dev/null && return 0
  [ ${#ADSB_SOFTWARE[@]} -gt 0 ]
}

# "120", "120m", "394ft" -> "120m" / "394ft" (what mlat-client and the
# partner feeders expect). Empty on bad input.
normalize_altitude() {
  local a="${1// /}"
  if [[ "$a" =~ ^-?[0-9]+(\.[0-9]+)?(m|ft)$ ]]; then echo "$a"
  elif [[ "$a" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then echo "${a}m"
  fi
}

valid_coord() {  # valid_coord <value> <limit>
  [[ "$1" =~ ^-?[0-9]{1,3}(\.[0-9]+)?$ ]] && awk -v v="$1" -v l="$2" 'BEGIN { exit !(v >= -l && v <= l && v != 0) }'
}

# Antenna location and MLAT name: from options, else asked. Exits when they
# are missing and there is nobody to ask, before anything is installed.
adsb_collect_location() {
  local tries
  if [ "$IS_TTY" = true ]; then
    if [ -z "$ADSB_LAT" ] || [ -z "$ADSB_LON" ] || [ -z "$ADSB_ALT" ]; then
      echo
      info "ADS-B feeds and MLAT need your antenna's position."
      info "Partners never show the exact spot."
    fi
    tries=0
    until valid_coord "$ADSB_LAT" 90; do
      [ $((tries++)) -lt 5 ] || { err "No valid latitude, stopping."; exit 1; }
      ADSB_LAT=$(ui_input "Antenna latitude, decimal degrees (e.g. 38.68001)")
    done
    tries=0
    until valid_coord "$ADSB_LON" 180; do
      [ $((tries++)) -lt 5 ] || { err "No valid longitude, stopping."; exit 1; }
      ADSB_LON=$(ui_input "Antenna longitude, decimal degrees (e.g. -120.99436)")
    done
    tries=0
    until [ -n "$(normalize_altitude "$ADSB_ALT")" ]; do
      [ $((tries++)) -lt 5 ] || { err "No valid altitude, stopping."; exit 1; }
      ADSB_ALT=$(ui_input "Antenna altitude above sea level, with m or ft (e.g. 120m)")
    done
    if [ -z "$ADSB_NAME" ]; then
      ADSB_NAME=$(ui_input "Name for the MLAT map (no spaces)" "${STATION_IDENT:-$(hostname -s 2>/dev/null || echo airframes)}")
    fi
  fi

  local missing=()
  valid_coord "$ADSB_LAT" 90 || missing+=("--lat")
  valid_coord "$ADSB_LON" 180 || missing+=("--lon")
  [ -n "$(normalize_altitude "$ADSB_ALT")" ] || missing+=("--alt")
  if [ ${#missing[@]} -gt 0 ]; then
    err "ADS-B feeding needs the antenna position: $(join_by ', ' "${missing[@]}")"
    echo "  e.g. curl -sSL https://install.airframes.sh/installer | bash -s -- -y adsb --lat 38.68001 --lon -120.99436 --alt 120m"
    exit 1
  fi
  ADSB_ALT=$(normalize_altitude "$ADSB_ALT")
  ADSB_NAME="${ADSB_NAME:-${STATION_IDENT:-$(hostname -s 2>/dev/null || echo airframes)}}"
  ADSB_NAME="${ADSB_NAME//[^A-Za-z0-9._-]/_}"

  if [ -z "$PLANEWATCH_KEY" ] && [ "$IS_TTY" = true ]; then
    echo
    info "Plane Watch needs a free API key: create a feeder at ${BOLD}https://atc.plane.watch${RESET}"
    PLANEWATCH_KEY=$(ui_input "Plane Watch API key (leave blank to skip)")
  fi
  return 0
}

# RTL-SDR for a readsb/ultrafeeder installed here: --adsb-device, else a
# serial that says 1090, else the first one the other decoders don't use.
# readsb reads an all-digit value as an index, so such serials become one.
adsb_pick_device() {
  [ -n "$ADSB_SDR_DEVICE" ] && return 0
  local i serial taken
  for i in "${!RTLSDR_SERIALS[@]}"; do
    taken=false
    if [ ${#SELECTED_DECODERS[@]} -gt 0 ] &&
       { [ "$i" = "$SDR_INDEX" ] || { [ -n "$SDR_SERIAL" ] && [ "${RTLSDR_SERIALS[$i]}" = "$SDR_SERIAL" ]; }; }; then
      taken=true
    fi
    serial="${RTLSDR_SERIALS[$i]}"
    if [[ "$serial" == *1090* ]] && [ "$taken" = false ]; then
      adsb_set_device "$i"; return 0
    fi
  done
  for i in "${!RTLSDR_SERIALS[@]}"; do
    if [ ${#SELECTED_DECODERS[@]} -gt 0 ] &&
       { [ "$i" = "$SDR_INDEX" ] || { [ -n "$SDR_SERIAL" ] && [ "${RTLSDR_SERIALS[$i]}" = "$SDR_SERIAL" ]; }; }; then
      continue
    fi
    adsb_set_device "$i"; return 0
  done
  ADSB_SDR_DEVICE="0"
}

adsb_set_device() {
  local i="$1" serial="${RTLSDR_SERIALS[$1]}"
  if rtlsdr_serial_unique "$serial" && [[ ! "$serial" =~ ^[0-9]+$ ]]; then
    ADSB_SDR_DEVICE="$serial"
  else
    ADSB_SDR_DEVICE="$i"
  fi
}

install_readsb_native() {
  step "Installing readsb (ADS-B decoder) with wiedehopf's installer"
  local tmp
  tmp=$(mktemp -d)
  curl -fsSL "$READSB_INSTALL_URL" -o "${tmp}/readsb-install.sh"
  sudo bash "${tmp}/readsb-install.sh"
  rm -rf "$tmp"

  if [ -f /etc/default/readsb ]; then
    sudo sed -i -E "/^[[:space:]]*#/b; s/--device[ =][^ \"]*/--device ${ADSB_SDR_DEVICE}/" /etc/default/readsb
    substep "readsb uses RTL-SDR ${ADSB_SDR_DEVICE}"
  fi
  if command -v readsb-set-location >/dev/null 2>&1 || [ -x /usr/local/bin/readsb-set-location ]; then
    sudo /usr/local/bin/readsb-set-location "$ADSB_LAT" "$ADSB_LON" >/dev/null
  fi
  sudo systemctl restart readsb 2>/dev/null || true
  ok "readsb installed (map at http://$(hostname -I 2>/dev/null | awk '{print $1}')/tar1090)"
}

feed_airplanes_live_native() {
  step "Feeding Airplanes.Live"
  if [ -f /etc/default/airplanes ]; then
    ok "Already set up for Airplanes.Live (/etc/default/airplanes); leaving it as it is."
    return 0
  fi
  if [ -f /boot/airplanes-config.txt ]; then
    ok "This is an Airplanes.Live image, which already feeds Airplanes.Live."
    return 0
  fi

  command -v git >/dev/null 2>&1 || pkg_install git
  sudo mkdir -p "$AIRPLANES_LIVE_DIR"
  if [ ! -d "${AIRPLANES_LIVE_DIR}/git/.git" ]; then
    sudo git clone --depth 1 "$AIRPLANES_LIVE_REPO" "${AIRPLANES_LIVE_DIR}/git"
  fi

  # Same settings the Airplanes.Live setup dialogs write
  sudo tee /etc/default/airplanes >/dev/null << EOF
INPUT="127.0.0.1:30005"
REDUCE_INTERVAL="0.5"

# feed name for checking MLAT sync, also shown on the MLAT map
USER="${ADSB_NAME}"

LATITUDE="${ADSB_LAT}"
LONGITUDE="${ADSB_LON}"

ALTITUDE="${ADSB_ALT}"

# source for 978 data (dump978 --raw-port); harmless when not receiving 978
UAT_INPUT="127.0.0.1:30978"

RESULTS="--results beast,connect,127.0.0.1:30104"
