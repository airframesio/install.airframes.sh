GITHUB_RELEASES="https://github.com/airframesio/install.airframes.sh/releases"

# ===========================================================================
# Section 3: Color & output utilities
# ===========================================================================

# IS_TTY says whether there is someone to answer prompts. main() sets it,
# after the entry point has pointed stdin at the terminal (see the end of the
# file). Colors only need stdout to be a terminal.
IS_TTY=false

if [ -t 1 ]; then
  BOLD="\033[1m"
  DIM="\033[2m"
  ITALIC="\033[3m"
  CYAN="\033[36m"
  GREEN="\033[32m"
  YELLOW="\033[33m"
  RED="\033[31m"
  MAGENTA="\033[35m"
  BLUE="\033[34m"
  RESET="\033[0m"
else
  BOLD="" DIM="" ITALIC="" CYAN="" GREEN="" YELLOW="" RED="" MAGENTA="" BLUE="" RESET=""
fi

info()    { echo -e "${CYAN}[airframes]${RESET} $*"; }
ok()      { echo -e "${GREEN}[airframes]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[airframes]${RESET} $*"; }
err()     { echo -e "${RED}[airframes]${RESET} $*" >&2; }
step()    { echo -e "\n${BOLD}==> $*${RESET}"; }
substep() { echo -e "  ${DIM}-> $*${RESET}"; }

