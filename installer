# Map OS/ARCH to release artifact platform string
get_platform_target() {
  local os_part arch_part
  case "$OS" in
    linux) os_part="linux" ;;
    macos) os_part="macos" ;;
    *)     os_part="unknown" ;;
  esac
  case "$ARCH" in
    x86_64|amd64)    arch_part="amd64" ;;
    aarch64|arm64)   arch_part="arm64" ;;
    armv7l|armhf)    arch_part="armhf" ;;
    *)               arch_part="$ARCH" ;;
  esac

  # macOS: only arm64 binaries are built (Intel Macs use Rosetta 2)
  if [ "$os_part" = "macos" ]; then
    arch_part="arm64"
  fi

  echo "${os_part}-${arch_part}"
}

# Find the latest GitHub release tag for a decoder.
# Returns the tag name (e.g. "acarsdec-v3.7") or empty string.
get_latest_release_tag() {
  local decoder="$1"
  local api_url="https://api.github.com/repos/${GITHUB_REPO}/releases"
  local releases

  releases=$(curl -fsSL "$api_url" --header "Accept: application/vnd.github.v3+json" 2>/dev/null) || return 1

  # Extract the first tag_name matching this decoder prefix (most recent)
  echo "$releases" | sed -n "s/.*\"tag_name\": \"\(${decoder}-v[^\"]*\)\".*/\1/p" | head -1
}

# Get download URL for a specific release tag and platform
get_release_download_url() {
  local tag="$1" decoder="$2" platform="$3"
  echo "${GITHUB_RELEASES}/download/${tag}/${decoder}-${platform}.tar.gz"
}

install_from_binary() {
  local decoder="$1"

  # Still need system libraries (librtlsdr, glib, etc.)
  install_decoder_deps "$decoder"

  local target
  target=$(get_platform_target)

  step "Checking for pre-built ${decoder} binary (${target})"

  local tag
  tag=$(get_latest_release_tag "$decoder")

  if [ -z "$tag" ]; then
    warn "No pre-built binary available for ${decoder}"
    info "Falling back to compile from source..."
    install_from_source "$decoder"
    return
  fi

  local url
  url=$(get_release_download_url "$tag" "$decoder" "$target")
  local version="${tag#${decoder}-v}"

  step "Downloading ${decoder} v${version}"
  substep "${url}"

  local tmpdir
  tmpdir=$(mktemp -d)

  if ! curl -fsSL "$url" -o "${tmpdir}/${decoder}.tar.gz" 2>/dev/null; then
    warn "Download failed for ${decoder} (${target})"
    info "Falling back to compile from source..."
    rm -rf "$tmpdir"
    install_from_source "$decoder"
    return
  fi

  step "Installing ${decoder} v${version}"

  tar xzf "${tmpdir}/${decoder}.tar.gz" -C "$tmpdir"

  # A binary built against a newer glibc, or missing a library, fails at
  # start with "GLIBC_2.38 not found" and the like. Check before installing
  # and build from source instead.
  if [ -f "${tmpdir}/bin/${decoder}" ] && [ "$OS" = "linux" ] && command -v ldd >/dev/null 2>&1; then
    local missing
    missing=$(LD_LIBRARY_PATH="${tmpdir}/lib" ldd "${tmpdir}/bin/${decoder}" 2>&1 | grep "not found" || true)
    if [ -n "$missing" ]; then
      warn "The pre-built ${decoder} doesn't run on this system:"
      echo "$missing" | sed 's/^[[:space:]]*/    /' >&2
      info "Falling back to compile from source..."
      rm -rf "$tmpdir"
      install_from_source "$decoder"
      return
    fi
  fi

  # Install binary
  if [ -f "${tmpdir}/bin/${decoder}" ]; then
    sudo install -m 0755 "${tmpdir}/bin/${decoder}" "/usr/local/bin/${decoder}"
    substep "Installed /usr/local/bin/${decoder}"
  else
    warn "Binary not found in archive"
    rm -rf "$tmpdir"
    install_from_source "$decoder"
    return
  fi

  # Install shared libraries (libacars)
  if [ -d "${tmpdir}/lib" ]; then
    sudo cp -a "${tmpdir}/lib/"* /usr/local/lib/
    substep "Installed shared libraries to /usr/local/lib/"
  fi

  if [ "$OS" = "linux" ]; then
    sudo ldconfig
  fi

  rm -rf "$tmpdir"

  ok "${decoder} v${version} installed (pre-built binary)"
}

